# =====================================================================
#  RescueOps - variables d'environnement
#  DÉVELOPPEMENT UNIQUEMENT : ces valeurs ne sont pas des secrets réels.
#  Copier ce fichier en ".env" (ignoré par Git) :  cp .env.example .env
# =====================================================================

# --- MySQL : compte root + un compte par microservice (accès à SA base uniquement)
MYSQL_ROOT_PASSWORD=dev_root
USER_DB_PASSWORD=dev_user
HOSPITAL_DB_PASSWORD=dev_hospital
EMERGENCY_DB_PASSWORD=dev_emergency
RESOURCE_DB_PASSWORD=dev_resource
DISPATCH_DB_PASSWORD=dev_dispatch
INTERVENTION_DB_PASSWORD=dev_intervention
TRAINING_DB_PASSWORD=dev_training

# --- Keycloak (console d'administration : http://localhost:8180)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev_keycloak

# --- RabbitMQ (console : http://localhost:15672)
RABBITMQ_USER=rescueops
RABBITMQ_PASSWORD=dev_rabbitmq

# --- Port MySQL côté machine (3306 souvent occupé par un MySQL Windows)
MYSQL_HOST_PORT=3307

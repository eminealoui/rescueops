{
  "realm": "rescueops",
  "displayName": "RescueOps",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(8) and digits(1) and upperCase(1) and specialChars(1) and notUsername",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "roles": {
    "realm": [
      {
        "name": "CITOYEN",
        "description": "Déclarer un incident et suivre ses informations"
      },
      {
        "name": "OPERATEUR",
        "description": "Qualifier et prioriser les incidents, valider les affectations"
      },
      {
        "name": "GESTIONNAIRE_RESSOURCES",
        "description": "Gérer ambulances, équipes, équipements et maintenances"
      },
      {
        "name": "AMBULANCIER",
        "description": "Suivre les missions, mettre à jour leur état, rédiger les rapports"
      },
      {
        "name": "COORDINATEUR_HOSPITALIER",
        "description": "Gérer les capacités hospitalières et traiter les transferts"
      },
      {
        "name": "FORMATEUR",
        "description": "Gérer formations, sessions, évaluations et certifications"
      },
      {
        "name": "APPRENANT",
        "description": "S'inscrire aux sessions et suivre les évaluations"
      },
      {
        "name": "ADMIN",
        "description": "Administrer les utilisateurs et consulter les journaux d'audit"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-rescueops",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "CITOYEN",
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-rescueops",
    "composite": true,
    "composites": {
      "realm": [
        "CITOYEN",
        "offline_access",
        "uma_authorization"
      ]
    }
  },
  "clients": [
    {
      "clientId": "rescueops-web",
      "name": "RescueOps - application Angular",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    },
    {
      "clientId": "rescueops-dev-cli",
      "name": "DEV UNIQUEMENT - tests, scripts et Postman (grant password)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        OUTIL DE TEST uniquement (hors <modules> du POM parent) :
        un faux microservice lancé sur la machine, comme un membre de l'équipe le ferait
        depuis IntelliJ, pour vérifier la chaîne Gateway (Docker) -> Eureka -> service (hôte).
    -->
    <parent>
        <groupId>tn.esprit.rescueops</groupId>
        <artifactId>rescueops-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>echo-service</artifactId>
    <name>echo-service (outil de smoke test)</name>

    <dependencies>
        <dependency>
            <groupId>tn.esprit.rescueops</groupId>
            <artifactId>rescueops-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
